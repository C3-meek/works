<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>業務日報アプリ</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#FAFAF8;--surface:#FFFFFF;--border:#E8E5DF;--border2:#D3D0C8;
  --text:#1A1A18;--text2:#6B6860;--text3:#9B9890;
  --accent:#1D9E75;--accent-light:#E1F5EE;--accent-text:#085041;
  --red:#D85A30;--red-light:#FAECE7;
  --amber:#BA7517;--amber-light:#FAEEDA;
  --blue:#185FA5;--blue-light:#E6F1FB;
  --font:'Hiragino Kaku Gothic ProN','Noto Sans JP','Meiryo',sans-serif;
  --radius:10px;--shadow:0 2px 16px rgba(0,0,0,0.07);
}
body{font-family:var(--font);background:var(--bg);color:var(--text);min-height:100vh;font-size:14px;line-height:1.6}

.app{max-width:980px;margin:0 auto;padding:28px 24px}

/* SETUP SCREEN */
.setup-screen{max-width:520px;margin:80px auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:36px 40px}
.setup-screen h2{font-size:18px;font-weight:700;margin-bottom:6px}
.setup-screen .desc{font-size:13px;color:var(--text2);margin-bottom:28px;line-height:1.7}
.setup-field{margin-bottom:16px}
.setup-field label{display:block;font-size:11.5px;font-weight:700;color:var(--text2);margin-bottom:5px;letter-spacing:0.05em;text-transform:uppercase}
.setup-field input{width:100%;padding:10px 12px;border:1px solid var(--border2);border-radius:7px;font-family:var(--font);font-size:13px;color:var(--text);background:var(--bg);outline:none;transition:border-color 0.15s}
.setup-field input:focus{border-color:var(--accent);background:var(--surface)}
.setup-hint{font-size:11.5px;color:var(--text3);margin-top:4px;line-height:1.6}
.setup-hint code{background:#F0EDE7;padding:1px 5px;border-radius:3px;font-size:11px}
.setup-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:24px}
.setup-error{background:var(--red-light);border:1px solid #F0997B;border-radius:7px;padding:10px 14px;font-size:12.5px;color:var(--red);margin-top:14px;display:none}

/* SYNC STATUS */
.sync-indicator{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;color:var(--text3)}
.sync-dot{width:7px;height:7px;border-radius:50%;background:var(--text3);flex-shrink:0;transition:background 0.3s}
.sync-dot.syncing{background:var(--amber);animation:pulse 1s infinite}
.sync-dot.ok{background:var(--accent)}
.sync-dot.error{background:var(--red)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* HEADER */
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;padding-bottom:18px;border-bottom:1.5px solid var(--border)}
.header-brand h1{font-size:17px;font-weight:700;letter-spacing:0.02em}
.header-brand .sub{font-size:11px;color:var(--text3);margin-top:2px}
.header-actions{display:flex;gap:8px;align-items:center}

.main{display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:7px;font-size:12.5px;font-family:var(--font);cursor:pointer;border:1px solid var(--border2);background:var(--surface);color:var(--text);transition:all 0.13s;white-space:nowrap}
.btn:hover{background:#F0EDE7;border-color:#B8B5AE}
.btn:disabled{opacity:0.45;cursor:not-allowed}
.btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-primary:hover{background:#0F6E56;border-color:#0F6E56}
.btn-danger{background:var(--red-light);border-color:#F0997B;color:var(--red)}
.btn-danger:hover{background:#F5C4B3}
.btn-sm{padding:5px 10px;font-size:12px}

/* CALENDAR */
.calendar-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px}
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.cal-nav-btn{background:none;border:1px solid var(--border);border-radius:6px;width:28px;height:28px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;color:var(--text2);transition:all 0.1s}
.cal-nav-btn:hover{background:var(--bg);border-color:var(--border2)}
.cal-title{font-size:14px;font-weight:700;color:var(--text)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.cal-dow{text-align:center;font-size:11px;color:var(--text3);padding:5px 0 4px;font-weight:600}
.cal-dow:first-child{color:#D85A30}
.cal-dow:last-child{color:#185FA5}
.cal-day{position:relative;aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:12px;cursor:pointer;transition:all 0.1s;border:1px solid transparent;user-select:none}
.cal-day:hover{background:var(--accent-light);border-color:#9FE1CB}
.cal-day.other-month{color:var(--text3)}
.cal-day.today{font-weight:800;color:var(--accent);border-color:var(--accent)}
.cal-day.selected{background:var(--accent);color:#fff!important;font-weight:700;border-color:var(--accent)}
.cal-day.selected:hover{background:#0F6E56}
.cal-day.has-report::after{content:'';position:absolute;bottom:3px;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:var(--accent)}
.cal-day.selected.has-report::after{background:rgba(255,255,255,0.6)}
.cal-day.sunday{color:#D85A30}
.cal-day.saturday{color:#185FA5}

.report-stats{margin-top:14px;padding-top:14px;border-top:1px solid var(--border);display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stat-item{text-align:center;background:var(--bg);border-radius:8px;padding:8px 4px}
.stat-num{font-size:20px;font-weight:700;color:var(--accent)}
.stat-label{font-size:10px;color:var(--text3);margin-top:1px}

/* FORM */
.form-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px}
.form-date-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.form-date-label{font-size:16px;font-weight:700}
.form-date-sub{font-size:12px;color:var(--text2);margin-top:3px}
.badge{display:inline-block;padding:3px 10px;border-radius:5px;font-size:11px;font-weight:600}
.badge-submitted{background:var(--accent-light);color:var(--accent-text)}
.badge-draft{background:var(--amber-light);color:var(--amber)}
.form-section{margin-bottom:16px}
.form-section label{display:block;font-size:11.5px;font-weight:700;color:var(--text2);margin-bottom:5px;letter-spacing:0.05em;text-transform:uppercase}
.form-section input[type=text],
.form-section input[type=time],
.form-section textarea{width:100%;padding:9px 12px;border:1px solid var(--border2);border-radius:7px;font-family:var(--font);font-size:13px;color:var(--text);background:var(--bg);transition:border-color 0.15s,background 0.15s;outline:none;resize:vertical}
.form-section input:focus,.form-section textarea:focus{border-color:var(--accent);background:var(--surface);box-shadow:0 0 0 3px rgba(29,158,117,0.1)}
.form-section textarea{min-height:72px;line-height:1.6}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.form-row .form-section{margin-bottom:0}

.task-list{list-style:none;margin-bottom:8px}
.task-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--border);border-radius:7px;margin-bottom:5px;background:var(--bg)}
.task-item.done-item{opacity:0.55}
.task-cb{width:16px;height:16px;accent-color:var(--accent);cursor:pointer;flex-shrink:0}
.task-txt{flex:1;border:none;background:none;padding:0;font-size:13px;color:var(--text);outline:none;font-family:var(--font)}
.task-del{background:none;border:none;cursor:pointer;color:var(--text3);font-size:18px;padding:0;line-height:1;width:20px;text-align:center}
.task-del:hover{color:var(--red)}
.add-task-btn{background:none;border:1.5px dashed var(--border2);border-radius:7px;width:100%;padding:7px;cursor:pointer;font-size:12px;color:var(--text2);font-family:var(--font);transition:all 0.1s}
.add-task-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-light)}
.time-row{display:flex;align-items:center;gap:8px}
.time-row input{width:120px!important;flex-shrink:0}
.time-sep{color:var(--text2);font-size:14px}
.time-calc{font-size:12px;color:var(--accent);font-weight:600;margin-left:4px}
.form-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)}

.empty-state{text-align:center;padding:60px 20px;color:var(--text3)}
.empty-icon{font-size:44px;margin-bottom:14px;display:block}
.empty-state p{font-size:13px;line-height:1.8}

.toast{position:fixed;bottom:28px;right:28px;background:#1A1A18;color:#fff;padding:10px 18px;border-radius:8px;font-size:12.5px;opacity:0;transition:opacity 0.25s;pointer-events:none;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2)}
.toast.show{opacity:1}

.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:1000;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border-radius:var(--radius);padding:24px;width:340px;box-shadow:0 8px 40px rgba(0,0,0,0.15)}
.modal h3{font-size:15px;font-weight:700;margin-bottom:10px}
.modal p{font-size:13px;color:var(--text2);line-height:1.7;margin-bottom:18px}
.modal-actions{display:flex;gap:8px;justify-content:flex-end}

@media print{
  body{background:#fff;color:#000;font-size:10.5pt}
  .header-actions,.form-actions,.add-task-btn,.task-del,.cal-nav-btn,
  .calendar-card,.report-stats,.modal-overlay,.toast,.sync-indicator{display:none!important}
  .main{display:block}
  .form-card{box-shadow:none;border:none;padding:0}
  .app{padding:0;max-width:100%}
  textarea,input{border:none!important;background:transparent!important;padding:0!important}
  .task-item{border:none;background:transparent;padding:2px 0}
}
</style>
</head>
<body>

<!-- ===== SETUP SCREEN ===== -->
<div id="setup-screen" class="setup-screen" style="display:none">
  <h2>🔧 Supabase 設定</h2>
  <p class="desc">
    Supabase の接続情報を入力してください。<br>
    入力内容はこのブラウザにのみ保存されます。
  </p>
  <div class="setup-field">
    <label>Project URL</label>
    <input type="text" id="setup-url" placeholder="https://xxxxxxxxxxxx.supabase.co" autocomplete="off">
    <div class="setup-hint">Supabase ダッシュボード → Settings → API → Project URL</div>
  </div>
  <div class="setup-field">
    <label>Anon Key (public)</label>
    <input type="text" id="setup-key" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." autocomplete="off">
    <div class="setup-hint">同ページの <code>anon</code> <code>public</code> キー</div>
  </div>
  <div class="setup-error" id="setup-error"></div>
  <div class="setup-actions">
    <button class="btn btn-sm btn-primary" onclick="connectSupabase()">接続する</button>
  </div>
</div>

<!-- ===== MAIN APP ===== -->
<div class="app" id="main-app" style="display:none">
  <div class="header">
    <div class="header-brand">
      <div>
        <h1>📋 業務日報</h1>
        <div class="sub">
          <span class="sync-indicator">
            <span class="sync-dot" id="sync-dot"></span>
            <span id="sync-label">接続中...</span>
          </span>
          &nbsp;·&nbsp;
          <span style="cursor:pointer;text-decoration:underline;text-underline-offset:2px" onclick="resetSettings()">設定変更</span>
        </div>
      </div>
    </div>
    <div class="header-actions">
      <button class="btn btn-sm" onclick="exportMonthPDF()">📄 月次PDF出力</button>
      <button class="btn btn-sm btn-primary" onclick="printCurrent()">🖨 この日報を印刷</button>
    </div>
  </div>

  <div class="main">
    <div>
      <div class="calendar-card">
        <div class="cal-nav">
          <button class="cal-nav-btn" onclick="changeMonth(-1)">‹</button>
          <span class="cal-title" id="cal-title"></span>
          <button class="cal-nav-btn" onclick="changeMonth(1)">›</button>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
        <div class="report-stats">
          <div class="stat-item"><div class="stat-num" id="stat-count">0</div><div class="stat-label">今月の日報</div></div>
          <div class="stat-item"><div class="stat-num" id="stat-hours">0</div><div class="stat-label">稼働時間</div></div>
          <div class="stat-item"><div class="stat-num" id="stat-tasks">0</div><div class="stat-label">完了タスク</div></div>
        </div>
      </div>
    </div>
    <div class="form-card" id="form-area">
      <div class="empty-state">
        <span class="empty-icon">📅</span>
        <p>カレンダーから日付を選んで<br>日報を記入してください</p>
      </div>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="delete-modal">
  <div class="modal">
    <h3>⚠️ 日報を削除しますか？</h3>
    <p>この操作は取り消せません。<br>Supabase 上のデータも削除されます。</p>
    <div class="modal-actions">
      <button class="btn btn-sm" onclick="closeDeleteModal()">キャンセル</button>
      <button class="btn btn-sm btn-danger" onclick="confirmDelete()">削除する</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =====================
   CONFIG
   ===================== */
const CONFIG_KEY = 'nippo_supabase_config';

function loadConfig() {
  try { return JSON.parse(localStorage.getItem(CONFIG_KEY)); } catch { return null; }
}
function saveConfig(url, key) {
  localStorage.setItem(CONFIG_KEY, JSON.stringify({ url: url.replace(/\/$/, ''), key }));
}
function clearConfig() {
  localStorage.removeItem(CONFIG_KEY);
}

/* =====================
   SUPABASE CLIENT
   ===================== */
let SB_URL = '', SB_KEY = '';

async function sbFetch(path, options = {}) {
  const res = await fetch(`${SB_URL}/rest/v1${path}`, {
    ...options,
    headers: {
      'apikey': SB_KEY,
      'Authorization': `Bearer ${SB_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': options.prefer || '',
      ...(options.headers || {})
    }
  });
  return res;
}

async function sbSelect(date_str) {
  const res = await sbFetch(`/daily_reports?date_str=eq.${date_str}&select=*`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const rows = await res.json();
  return rows[0] || null;
}

async function sbUpsert(data) {
  const res = await sbFetch('/daily_reports', {
    method: 'POST',
    prefer: 'resolution=merge-duplicates,return=representation',
    body: JSON.stringify(data)
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err.message || `HTTP ${res.status}`);
  }
  return res.json();
}

async function sbDelete(date_str) {
  const res = await sbFetch(`/daily_reports?date_str=eq.${date_str}`, { method: 'DELETE' });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
}

async function sbSelectMonth(year, month) {
  const from = `${year}-${String(month+1).padStart(2,'0')}-01`;
  const to   = `${year}-${String(month+1).padStart(2,'0')}-31`;
  const res = await sbFetch(`/daily_reports?date_str=gte.${from}&date_str=lte.${to}&select=*&order=date_str.asc`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

/* =====================
   CACHE (月単位)
   ===================== */
let monthCache = {}; // key: "YYYY-MM" → { "YYYY-MM-DD": rowOrNull }

function cacheKey(y, m) { return `${y}-${String(m+1).padStart(2,'0')}`; }

async function loadMonth(y, m) {
  const ck = cacheKey(y, m);
  if (monthCache[ck]) return monthCache[ck];
  setSyncStatus('syncing', '読み込み中...');
  try {
    const rows = await sbSelectMonth(y, m);
    const map = {};
    rows.forEach(r => { map[r.date_str] = r; });
    monthCache[ck] = map;
    setSyncStatus('ok', 'Supabase 接続済');
    return map;
  } catch(e) {
    setSyncStatus('error', '接続エラー');
    throw e;
  }
}

function invalidateMonth(y, m) {
  delete monthCache[cacheKey(y, m)];
}

function getCached(ds) {
  const [y, m] = ds.split('-').map(Number);
  const ck = cacheKey(y, m-1);
  return monthCache[ck]?.[ds] || null;
}

/* =====================
   STATE
   ===================== */
const DOW = ['日','月','火','水','木','金','土'];
const MONTHS_JP = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
const now = new Date();
let curYear = now.getFullYear(), curMonth = now.getMonth();
let selectedDate = null;
let tasks = [];
const todayStr = fmtDate(now);

function fmtDate(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function parseDate(s) {
  const [y,m,d] = s.split('-').map(Number);
  return new Date(y, m-1, d);
}

/* =====================
   SYNC STATUS
   ===================== */
function setSyncStatus(state, label) {
  const dot = document.getElementById('sync-dot');
  const lbl = document.getElementById('sync-label');
  if (!dot) return;
  dot.className = 'sync-dot ' + state;
  lbl.textContent = label;
}

/* =====================
   SETUP / CONNECT
   ===================== */
async function connectSupabase() {
  const url = document.getElementById('setup-url').value.trim();
  const key = document.getElementById('setup-key').value.trim();
  const errEl = document.getElementById('setup-error');
  errEl.style.display = 'none';

  if (!url || !key) { showSetupError('URL と Anon Key を両方入力してください'); return; }
  if (!url.startsWith('https://')) { showSetupError('URL は https:// から始まる必要があります'); return; }

  SB_URL = url.replace(/\/$/, '');
  SB_KEY = key;

  // 接続テスト
  try {
    const res = await fetch(`${SB_URL}/rest/v1/daily_reports?limit=1`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (res.status === 404 || res.status === 400) {
      const body = await res.json().catch(() => ({}));
      if (body.message && body.message.includes('relation')) {
        showSetupError('テーブル "daily_reports" が見つかりません。下記のSQLを実行してからお試しください。\n\n' + setupSQL());
        return;
      }
    }
    if (!res.ok && res.status !== 200) {
      showSetupError(`接続エラー (HTTP ${res.status})。URL と Key を確認してください。`);
      return;
    }
  } catch(e) {
    showSetupError(`接続できません: ${e.message}`);
    return;
  }

  saveConfig(url, key);
  startApp();
}

function setupSQL() {
  return `create table daily_reports (
  id bigserial primary key,
  date_str text unique not null,
  title text default '',
  client text default '',
  time_start text default '',
  time_end text default '',
  tasks jsonb default '[]',
  work text default '',
  issue text default '',
  next_plan text default '',
  memo text default '',
  submitted boolean default false,
  updated_at timestamptz default now()
);`;
}

function showSetupError(msg) {
  const el = document.getElementById('setup-error');
  el.textContent = msg;
  el.style.display = 'block';
}

function resetSettings() {
  if (!confirm('設定をリセットして再設定画面に戻りますか？\nデータは Supabase に残ります。')) return;
  clearConfig();
  monthCache = {};
  document.getElementById('main-app').style.display = 'none';
  document.getElementById('setup-screen').style.display = 'block';
}

async function startApp() {
  document.getElementById('setup-screen').style.display = 'none';
  document.getElementById('main-app').style.display = 'block';
  setSyncStatus('syncing', '読み込み中...');
  await loadMonth(curYear, curMonth).catch(() => {});
  renderCalendar();
  updateStats();
  selectDate(todayStr);
}

/* =====================
   CALENDAR
   ===================== */
function renderCalendar() {
  document.getElementById('cal-title').textContent = `${curYear}年 ${MONTHS_JP[curMonth]}`;
  const grid = document.getElementById('cal-grid');
  grid.innerHTML = '';
  DOW.forEach(d => {
    const el = document.createElement('div');
    el.className = 'cal-dow'; el.textContent = d;
    grid.appendChild(el);
  });
  const first = new Date(curYear, curMonth, 1);
  const last  = new Date(curYear, curMonth+1, 0);
  const startDow = first.getDay();
  for (let i = 0; i < startDow; i++) addDayCell(grid, new Date(curYear, curMonth, 1-startDow+i), true);
  for (let d = 1; d <= last.getDate(); d++) addDayCell(grid, new Date(curYear, curMonth, d), false);
  const remain = 7 - ((startDow + last.getDate()) % 7);
  if (remain < 7) for (let i = 1; i <= remain; i++) addDayCell(grid, new Date(curYear, curMonth+1, i), true);
}

function addDayCell(grid, dt, other) {
  const ds = fmtDate(dt);
  const el = document.createElement('div');
  el.className = 'cal-day';
  if (other) el.classList.add('other-month');
  if (ds === todayStr) el.classList.add('today');
  if (ds === selectedDate) el.classList.add('selected');
  if (getCached(ds)) el.classList.add('has-report');
  const dow = dt.getDay();
  if (!other && dow === 0) el.classList.add('sunday');
  if (!other && dow === 6) el.classList.add('saturday');
  el.textContent = dt.getDate();
  el.onclick = () => selectDate(ds);
  grid.appendChild(el);
}

async function changeMonth(dir) {
  curMonth += dir;
  if (curMonth > 11) { curMonth = 0; curYear++; }
  if (curMonth < 0)  { curMonth = 11; curYear--; }
  await loadMonth(curYear, curMonth).catch(() => {});
  renderCalendar();
  updateStats();
}

/* =====================
   STATS
   ===================== */
function updateStats() {
  const ck = cacheKey(curYear, curMonth);
  const map = monthCache[ck] || {};
  let count = 0, totalMins = 0, doneTasks = 0;
  Object.values(map).forEach(r => {
    if (!r) return;
    count++;
    if (r.time_start && r.time_end) {
      const [sh,sm] = r.time_start.split(':').map(Number);
      const [eh,em] = r.time_end.split(':').map(Number);
      const m = eh*60+em - sh*60-sm;
      if (m > 0) totalMins += m;
    }
    if (r.tasks) doneTasks += r.tasks.filter(t => t.done).length;
  });
  const h = Math.floor(totalMins/60), m = totalMins%60;
  document.getElementById('stat-count').textContent = count;
  document.getElementById('stat-hours').textContent = m > 0 ? `${h}.${Math.round(m/6)}` : `${h}`;
  document.getElementById('stat-tasks').textContent = doneTasks;
}

/* =====================
   FORM
   ===================== */
function labelDate(ds) {
  const dt = parseDate(ds);
  return `${dt.getFullYear()}年${dt.getMonth()+1}月${dt.getDate()}日（${DOW[dt.getDay()]}）`;
}

async function selectDate(ds) {
  selectedDate = ds;
  renderCalendar();
  // キャッシュ済みならすぐ表示、なければフェッチ
  const cached = getCached(ds);
  renderForm(ds, cached);
  if (!cached) {
    try {
      setSyncStatus('syncing', '読み込み中...');
      const row = await sbSelect(ds);
      setSyncStatus('ok', 'Supabase 接続済');
      if (row) {
        // キャッシュに反映
        const [y,mo] = ds.split('-').map(Number);
        const ck = cacheKey(y, mo-1);
        if (!monthCache[ck]) monthCache[ck] = {};
        monthCache[ck][ds] = row;
        renderCalendar();
        updateStats();
        if (selectedDate === ds) renderForm(ds, row);
      }
    } catch(e) {
      setSyncStatus('error', '読み込みエラー');
    }
  }
}

function renderForm(ds, row) {
  const r = row ? {
    title: row.title||'', client: row.client||'',
    timeStart: row.time_start||'09:00', timeEnd: row.time_end||'18:00',
    tasks: row.tasks||[{text:'',done:false}],
    work: row.work||'', issue: row.issue||'',
    next: row.next_plan||'', memo: row.memo||'',
    submitted: row.submitted||false
  } : {
    title:'', client:'', timeStart:'09:00', timeEnd:'18:00',
    tasks:[{text:'',done:false}], work:'', issue:'', next:'', memo:'', submitted:false
  };
  tasks = r.tasks.map(t => ({...t}));

  const area = document.getElementById('form-area');
  area.innerHTML = `
    <div class="form-date-header">
      <div>
        <div class="form-date-label">${labelDate(ds)}</div>
        <div class="form-date-sub" id="form-client-sub">${r.client||'（クライアント名未設定）'}</div>
      </div>
      <span class="badge ${r.submitted?'badge-submitted':'badge-draft'}" id="status-badge">
        ${r.submitted?'✓ 提出済':'下書き'}
      </span>
    </div>
    <div class="form-row">
      <div class="form-section">
        <label>タイトル</label>
        <input type="text" id="f-title" value="${esc(r.title)}" placeholder="本日の業務タイトル">
      </div>
      <div class="form-section">
        <label>クライアント名</label>
        <input type="text" id="f-client" value="${esc(r.client)}" placeholder="○○株式会社"
          oninput="document.getElementById('form-client-sub').textContent=this.value||'（クライアント名未設定）'">
      </div>
    </div>
    <div class="form-section">
      <label>作業時間</label>
      <div class="time-row">
        <input type="time" id="f-start" value="${esc(r.timeStart)}" oninput="calcHours()">
        <span class="time-sep">〜</span>
        <input type="time" id="f-end" value="${esc(r.timeEnd)}" oninput="calcHours()">
        <span class="time-calc" id="time-calc"></span>
      </div>
    </div>
    <div class="form-section">
      <label>タスク一覧</label>
      <ul class="task-list" id="task-list"></ul>
      <button class="add-task-btn" onclick="addTask()">＋ タスクを追加</button>
    </div>
    <div class="form-section">
      <label>作業内容・成果</label>
      <textarea id="f-work" rows="5" placeholder="本日実施した作業の詳細、進捗状況、達成した成果を記入...">${esc(r.work)}</textarea>
    </div>
    <div class="form-row">
      <div class="form-section">
        <label>課題・問題点</label>
        <textarea id="f-issue" rows="3" placeholder="発生した問題・懸念事項...">${esc(r.issue)}</textarea>
      </div>
      <div class="form-section">
        <label>翌日の予定</label>
        <textarea id="f-next" rows="3" placeholder="明日実施予定の作業...">${esc(r.next)}</textarea>
      </div>
    </div>
    <div class="form-section">
      <label>連絡事項・メモ</label>
      <textarea id="f-memo" rows="2" placeholder="クライアントへの連絡事項など...">${esc(r.memo)}</textarea>
    </div>
    <div class="form-actions">
      <button class="btn btn-sm btn-danger" onclick="openDeleteModal()">🗑 削除</button>
      <span style="flex:1"></span>
      <button class="btn btn-sm" onclick="doSave(false)" id="save-draft-btn">💾 下書き保存</button>
      <button class="btn btn-sm btn-primary" onclick="doSave(true)" id="save-submit-btn">✓ 確定・提出済にする</button>
    </div>
  `;
  renderTasks();
  calcHours();
}

/* =====================
   TASKS
   ===================== */
function renderTasks() {
  const ul = document.getElementById('task-list');
  if (!ul) return;
  ul.innerHTML = '';
  tasks.forEach((t, i) => {
    const li = document.createElement('li');
    li.className = 'task-item' + (t.done?' done-item':'');
    li.innerHTML = `
      <input type="checkbox" class="task-cb" ${t.done?'checked':''}
        onchange="tasks[${i}].done=this.checked;this.closest('li').classList.toggle('done-item',this.checked)">
      <input type="text" class="task-txt" value="${esc(t.text)}"
        placeholder="タスク内容を入力" oninput="tasks[${i}].text=this.value"
        ${t.done?'style="text-decoration:line-through;color:var(--text3)"':''}>
      <button class="task-del" onclick="removeTask(${i})">×</button>`;
    ul.appendChild(li);
  });
}
function addTask() {
  tasks.push({text:'',done:false}); renderTasks();
  const inputs = document.querySelectorAll('.task-txt');
  if (inputs.length) inputs[inputs.length-1].focus();
}
function removeTask(i) { tasks.splice(i,1); renderTasks(); }

function calcHours() {
  const s = document.getElementById('f-start')?.value;
  const e = document.getElementById('f-end')?.value;
  const el = document.getElementById('time-calc');
  if (!s||!e||!el) return;
  const [sh,sm]=s.split(':').map(Number), [eh,em]=e.split(':').map(Number);
  const mins=eh*60+em-sh*60-sm;
  el.textContent = mins>0 ? `${Math.floor(mins/60)}時間${mins%60?mins%60+'分':''}` : '';
}

/* =====================
   SAVE / DELETE
   ===================== */
function collectForm(submitted) {
  return {
    date_str: selectedDate,
    title:      document.getElementById('f-title')?.value||'',
    client:     document.getElementById('f-client')?.value||'',
    time_start: document.getElementById('f-start')?.value||'',
    time_end:   document.getElementById('f-end')?.value||'',
    tasks:      tasks.map(t=>({...t})),
    work:       document.getElementById('f-work')?.value||'',
    issue:      document.getElementById('f-issue')?.value||'',
    next_plan:  document.getElementById('f-next')?.value||'',
    memo:       document.getElementById('f-memo')?.value||'',
    submitted,
    updated_at: new Date().toISOString()
  };
}

async function doSave(submitted) {
  if (!selectedDate) return;
  const saveBtn = document.getElementById(submitted?'save-submit-btn':'save-draft-btn');
  if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = '保存中...'; }
  setSyncStatus('syncing', '保存中...');
  try {
    const data = collectForm(submitted);
    await sbUpsert(data);
    // キャッシュ更新
    const [y,mo] = selectedDate.split('-').map(Number);
    const ck = cacheKey(y, mo-1);
    if (!monthCache[ck]) monthCache[ck] = {};
    monthCache[ck][selectedDate] = data;
    setSyncStatus('ok', 'Supabase 接続済');
    renderCalendar(); updateStats();
    const badge = document.getElementById('status-badge');
    if (badge) {
      badge.className = `badge ${submitted?'badge-submitted':'badge-draft'}`;
      badge.textContent = submitted ? '✓ 提出済' : '下書き';
    }
    showToast(submitted ? '✓ 提出済として保存しました' : '💾 下書きを保存しました');
  } catch(e) {
    setSyncStatus('error', '保存エラー');
    showToast('❌ 保存に失敗しました: ' + e.message);
  } finally {
    if (saveBtn) {
      saveBtn.disabled = false;
      saveBtn.textContent = submitted ? '✓ 確定・提出済にする' : '💾 下書き保存';
    }
  }
}

let deleteTarget = null;
function openDeleteModal() { deleteTarget = selectedDate; document.getElementById('delete-modal').classList.add('open'); }
function closeDeleteModal() { document.getElementById('delete-modal').classList.remove('open'); deleteTarget = null; }
async function confirmDelete() {
  if (!deleteTarget) return;
  closeDeleteModal();
  setSyncStatus('syncing', '削除中...');
  try {
    await sbDelete(deleteTarget);
    const [y,mo] = deleteTarget.split('-').map(Number);
    const ck = cacheKey(y, mo-1);
    if (monthCache[ck]) delete monthCache[ck][deleteTarget];
    setSyncStatus('ok', 'Supabase 接続済');
    selectedDate = null;
    renderCalendar(); updateStats();
    document.getElementById('form-area').innerHTML = `<div class="empty-state"><span class="empty-icon">🗑</span><p>削除しました<br>別の日付を選んでください</p></div>`;
    showToast('削除しました');
  } catch(e) {
    setSyncStatus('error', '削除エラー');
    showToast('❌ 削除に失敗しました');
  }
}

/* =====================
   PRINT / PDF
   ===================== */
function printCurrent() {
  if (!selectedDate) { alert('日付を選択してください'); return; }
  window.print();
}

async function exportMonthPDF() {
  setSyncStatus('syncing', '読み込み中...');
  let reports;
  try {
    reports = await sbSelectMonth(curYear, curMonth);
    setSyncStatus('ok', 'Supabase 接続済');
  } catch(e) {
    setSyncStatus('error', 'エラー');
    alert('データ取得に失敗しました: ' + e.message); return;
  }
  if (!reports.length) { alert('今月の日報がありません'); return; }

  const styles = `
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Hiragino Kaku Gothic ProN','Noto Sans JP','Meiryo',sans-serif;font-size:10.5pt;color:#1a1a18;padding:18mm 20mm;line-height:1.7}
    h1{font-size:15pt;text-align:center;margin-bottom:8mm;padding-bottom:4mm;border-bottom:2px solid #1D9E75}
    .summary{text-align:center;font-size:9.5pt;color:#6B6860;margin-bottom:8mm}
    .report{margin-bottom:10mm;padding-bottom:8mm;border-bottom:1px solid #E8E5DF;page-break-inside:avoid}
    .report:last-child{border-bottom:none}
    .r-header{background:#F0FAF6;border-left:4px solid #1D9E75;padding:3.5mm 6mm;margin-bottom:5mm;display:flex;justify-content:space-between;align-items:center}
    .r-date{font-size:12pt;font-weight:bold}
    .r-client{font-size:9.5pt;color:#6B6860;margin-top:1mm}
    .r-time{font-size:10pt;color:#0F6E56;font-weight:700}
    .badge-ok{background:#E1F5EE;color:#085041;padding:1.5mm 3mm;border-radius:3px;font-size:8.5pt;font-weight:700;display:inline-block;margin-top:1.5mm}
    .badge-draft{background:#FAEEDA;color:#BA7517;padding:1.5mm 3mm;border-radius:3px;font-size:8.5pt;font-weight:700;display:inline-block;margin-top:1.5mm}
    .sec{margin-bottom:4mm}
    .sec-label{font-size:9pt;font-weight:bold;color:#6B6860;border-bottom:0.5px solid #E8E5DF;padding-bottom:1mm;margin-bottom:2mm;letter-spacing:0.05em}
    .sec-val{font-size:10pt;white-space:pre-wrap}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:6mm;margin-bottom:4mm}
    .task-row{display:flex;gap:3mm;padding:1.5mm 0;border-bottom:0.5px solid #F0EDE7;font-size:10pt}
    .task-cb{width:11pt;height:11pt;border:1.5px solid #1D9E75;border-radius:2px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:8.5pt;color:#1D9E75;margin-top:1.5pt}
    @media print{body{padding:12mm 15mm}}
  `;

  let body = '', totalMins = 0, doneTasks = 0;
  reports.forEach(r => {
    let mins = 0;
    if (r.time_start && r.time_end) {
      const [sh,sm]=r.time_start.split(':').map(Number),[eh,em]=r.time_end.split(':').map(Number);
      mins = Math.max(0, eh*60+em-sh*60-sm); totalMins += mins;
    }
    const hh=Math.floor(mins/60),mm2=mins%60;
    const timeLabel = mins>0 ? `${r.time_start} 〜 ${r.time_end}（${hh}時間${mm2?mm2+'分':''}）` : `${r.time_start||''} 〜 ${r.time_end||''}`;
    const dt = parseDate(r.date_str);
    const dateLabel = `${dt.getFullYear()}年${dt.getMonth()+1}月${dt.getDate()}日（${DOW[dt.getDay()]}）${r.title?' — '+r.title:''}`;
    body += `<div class="report"><div class="r-header"><div><div class="r-date">${dateLabel}</div><div class="r-client">${sh2(r.client)||'　'}</div></div><div style="text-align:right"><div class="r-time">${sh2(timeLabel)}</div><span class="${r.submitted?'badge-ok':'badge-draft'}">${r.submitted?'✓ 提出済':'下書き'}</span></div></div>`;
    const vt = (r.tasks||[]).filter(t=>t.text);
    if (vt.length) {
      body += `<div class="sec"><div class="sec-label">タスク</div>`;
      vt.forEach(t => { if(t.done) doneTasks++; body += `<div class="task-row"><div class="task-cb">${t.done?'✓':''}</div><div>${sh2(t.text)}</div></div>`; });
      body += `</div>`;
    }
    if (r.work) body += `<div class="sec"><div class="sec-label">作業内容・成果</div><div class="sec-val">${sh2(r.work)}</div></div>`;
    if (r.issue||r.next_plan) {
      body += `<div class="grid2">`;
      if (r.issue) body += `<div class="sec"><div class="sec-label">課題・問題点</div><div class="sec-val">${sh2(r.issue)}</div></div>`;
      if (r.next_plan) body += `<div class="sec"><div class="sec-label">翌日の予定</div><div class="sec-val">${sh2(r.next_plan)}</div></div>`;
      body += `</div>`;
    }
    if (r.memo) body += `<div class="sec"><div class="sec-label">連絡事項</div><div class="sec-val">${sh2(r.memo)}</div></div>`;
    body += `</div>`;
  });

  const win = window.open('','_blank');
  win.document.write(`<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><title>${curYear}年${MONTHS_JP[curMonth]} 業務日報</title><style>${styles}</style></head><body>
    <h1>${curYear}年${MONTHS_JP[curMonth]}　業務日報</h1>
    <div class="summary">${reports.length}件 ／ 稼働合計 ${Math.floor(totalMins/60)}時間 ／ 完了タスク ${doneTasks}件</div>
    ${body}</body></html>`);
  win.document.close();
  setTimeout(() => win.print(), 600);
}

/* =====================
   UTILS
   ===================== */
function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function sh2(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2400);
}

document.addEventListener('keydown', e => {
  if ((e.metaKey||e.ctrlKey) && e.key==='s') { e.preventDefault(); if (selectedDate) doSave(false); }
});

/* =====================
   INIT
   ===================== */
const cfg = loadConfig();
if (cfg && cfg.url && cfg.key) {
  SB_URL = cfg.url; SB_KEY = cfg.key;
  startApp();
} else {
  document.getElementById('setup-screen').style.display = 'block';
}
</script>
</body>
